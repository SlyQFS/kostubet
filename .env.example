# =====================================================================
# Kostubet GitHub & APK Watcher Bot — Configuration
# =====================================================================

# Telegram Bot Token from @BotFather (required)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ

# Target group/channel chat ID where release cards will be published
# Example: -1001234567890
TELEGRAM_CHAT_ID=-1001234567890

# Optional topic/thread ID in forum-enabled supergroups.
# It is the message_thread_id of the topic: open the topic in Telegram and
# take the last number from the link, e.g. t.me/c/1234567890/42 -> 42.
# Leave empty to post into "General".
TELEGRAM_ARCHIVE_THREAD_ID=

# GitHub Personal Access Token (PAT) for API requests (optional, but raises rate limit from 60 to 5000/hr)
GITHUB_TOKEN=

# Comma-separated list of admin Telegram User IDs (first ID is designated as the bot Owner)
# Example: 123456789,987654321
ADMIN_USER_IDS=123456789

# Polling interval in seconds (default: 900 = 15 minutes)
POLL_INTERVAL_SECS=900

# Post pre-releases (beta builds) of tracked repositories: true / false
POST_PRERELEASES=true

# SQLite database file path (default: "kostubet.db")
DB_PATH=kostubet.db

# Test / Dry-Run mode: 1 / true sends cards to Telegram without updating release state in DB
DRY_RUN=false

# Tracing / Logging verbosity filter
RUST_LOG=kostubet_github=info,teloxide=info
