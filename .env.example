# ==========================================
# Kostubet GitHub Watcher Environment Variables
# ==========================================

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ

# Required: Target Chat ID (negative integer for supergroups)
TELEGRAM_CHAT_ID=-1001234567890

# Optional: Topic Message Thread ID for forum supergroups
TELEGRAM_ARCHIVE_THREAD_ID=42

# Optional: Telegram User IDs of administrators (comma-separated)
ADMIN_USER_IDS=123456789

# Optional: GitHub Personal Access Token (PAT) for 5000 requests/hr rate limit
GITHUB_TOKEN=

# Optional: Repositories to track directly without config.toml (comma-separated)
TRACKED_REPOS=rust-lang/rust,tokio-rs/tokio,teloxide/teloxide

# Optional: Enable/disable update checks (true / false)
CHECK_RELEASES=true
CHECK_TAGS=true
CHECK_COMMITS=true

# Optional: Polling interval in seconds (default: 900 = 15 minutes)
POLL_INTERVAL_SECS=900

# Optional: SQLite Database path inside container
DB_PATH=/app/data/kostubet.db

# Optional: Set to 'true' or '1' to run test dry-run mode
DRY_RUN=false
