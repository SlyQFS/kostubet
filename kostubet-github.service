[Unit]
Description=Kostubet GitHub Watcher Telegram Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=slyqfs
WorkingDirectory=/home/slyqfs/Documents/Projects/KostubetGithub
ExecStart=/home/slyqfs/Documents/Projects/KostubetGithub/target/release/kostubet-github
Restart=on-failure
RestartSec=10s

# Environment variables (or load from /etc/kostubet-github.env)
Environment=RUST_LOG=kostubet_github=info,teloxide=info
# Environment=TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
# Environment=TELEGRAM_CHAT_ID=-1001234567890
# Environment=TELEGRAM_ARCHIVE_THREAD_ID=42

# Security Hardening
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/slyqfs/Documents/Projects/KostubetGithub
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
